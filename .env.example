# ==============================================================================
# InsiderLens Environment Configuration
# ==============================================================================

# Database
DUCKDB_PATH=data/golden_seed.duckdb
IDENTITY_MAP_PATH=data/identity_map.json

# LLM Configuration (Open On-Prem Model default: Qwen 2.5 / Llama 3.1)
# Supported Providers: ollama | vllm | openai_compatible | anthropic | mock
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# Model Specifications
# Fast Model: Used for single-domain destination classification & fast extraction
LLM_FAST_MODEL=qwen2.5:7b

# Strong Model: Used for agent investigation, reasoning, and report generation
LLM_STRONG_MODEL=qwen2.5:14b

# Offline / Demo Mode:
# 0 = attempt live LLM call, falling back to disk cache/template
# 1 = strictly serve from disk cache or deterministic template (perfect for disconnected demos)
LLM_OFFLINE=0

# API & Web UI
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501
